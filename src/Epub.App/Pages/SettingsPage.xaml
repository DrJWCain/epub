<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Epub_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Epub_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,16">
        <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Library" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Folder containing your EPUB files. The library page will list every .epub it finds in this folder." />

                <Border
                    Padding="12"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="FolderPathText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Text="(not set)"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="ChangeFolderButton"
                            Grid.Column="1"
                            Click="ChangeFolder_Click"
                            Content="Change folder…" />
                        <Button
                            x:Name="ClearFolderButton"
                            Grid.Column="2"
                            Click="ClearFolder_Click"
                            Content="Clear"
                            IsEnabled="False" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Semantic search" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Build a local index of every paragraph in your library so search can find passages by meaning, not just by keyword. The first build downloads a small AI model (~90 MB) once and then runs entirely offline." />

                <Border
                    Padding="12"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Name="IndexStatusText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Status not loaded yet…" />
                        <ProgressBar
                            x:Name="IndexProgressBar"
                            Minimum="0"
                            Maximum="1"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="IndexProgressText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="BuildIndexButton"
                                Grid.Column="1"
                                Click="BuildIndex_Click"
                                Content="Build index" />
                            <Button
                                x:Name="CancelIndexButton"
                                Grid.Column="2"
                                Click="CancelIndex_Click"
                                Content="Cancel"
                                Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
