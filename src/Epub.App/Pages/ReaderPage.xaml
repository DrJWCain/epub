<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Epub_App.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reader="using:Epub_Renderer"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Left">
            <AppBarButton
                Click="OpenEpub_Click"
                Icon="OpenFile"
                Label="Open EPUB" />
            <AppBarSeparator />
            <AppBarButton
                x:Name="PrevButton"
                Click="Prev_Click"
                Icon="Previous"
                IsEnabled="False"
                Label="Previous">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Left" />
                    <KeyboardAccelerator Key="PageUp" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarElementContainer VerticalAlignment="Center">
                <TextBlock
                    x:Name="ProgressLabel"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="—" />
            </AppBarElementContainer>
            <AppBarButton
                x:Name="NextButton"
                Click="Next_Click"
                Icon="Next"
                IsEnabled="False"
                Label="Next">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Right" />
                    <KeyboardAccelerator Key="PageDown" />
                    <KeyboardAccelerator Key="Space" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1">
            <reader:ReaderControl x:Name="ReaderControl" Visibility="Collapsed" />
            <TextBlock
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="No book open. Click Open EPUB to load one." />
        </Grid>
    </Grid>
</Page>
