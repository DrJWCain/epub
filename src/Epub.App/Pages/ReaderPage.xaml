<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Epub_App.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Epub_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reader="using:Epub_Renderer"
    xmlns:webview2="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Left">
            <AppBarToggleButton
                x:Name="TocToggle"
                Click="TocToggle_Click"
                Icon="List"
                IsEnabled="False"
                Label="Contents" />
            <AppBarSeparator />
            <AppBarButton
                Click="OpenEpub_Click"
                Icon="OpenFile"
                Label="Open EPUB" />
            <AppBarButton
                Click="OpenPdf_Click"
                Icon="OpenFile"
                Label="Open PDF" />
            <AppBarSeparator />
            <AppBarButton
                x:Name="PrevButton"
                Click="Prev_Click"
                Icon="Previous"
                IsEnabled="False"
                Label="Previous">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Left" />
                    <KeyboardAccelerator Key="PageUp" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarElementContainer VerticalAlignment="Center">
                <TextBlock
                    x:Name="ProgressLabel"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="—" />
            </AppBarElementContainer>
            <AppBarButton
                x:Name="NextButton"
                Click="Next_Click"
                Icon="Next"
                IsEnabled="False"
                Label="Next">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Right" />
                    <KeyboardAccelerator Key="PageDown" />
                    <KeyboardAccelerator Key="Space" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>

        <SplitView
            x:Name="TocSplitView"
            Grid.Row="1"
            DisplayMode="Overlay"
            IsPaneOpen="False"
            OpenPaneLength="320"
            PanePlacement="Left">
            <SplitView.Pane>
                <Grid Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <ListView
                        x:Name="TocList"
                        IsItemClickEnabled="True"
                        ItemClick="TocList_ItemClick"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:TocItem">
                                <TextBlock
                                    Margin="{x:Bind PaddingLeft}"
                                    Text="{x:Bind Title}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid>
                    <reader:ReaderControl x:Name="ReaderControl" Visibility="Collapsed" />
                    <webview2:WebView2 x:Name="PdfView" Visibility="Collapsed" />
                    <TextBlock
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="No book open. Click Open EPUB or Open PDF to load one." />
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
