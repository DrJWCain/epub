<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Epub_App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Epub_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Padding="24,16,24,8"
            Spacing="6">
            <TextBox
                x:Name="QueryBox"
                PlaceholderText="Search across your library…"
                TextChanged="Query_TextChanged" />
            <TextBlock
                x:Name="StatusLabel"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="" />
        </StackPanel>

        <ListView
            x:Name="ResultsList"
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="Result_Click"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SearchResultItem">
                    <StackPanel Padding="0,8,0,8" Spacing="4">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind Snippet}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Subtitle}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyState"
            Grid.Row="1"
            Margin="48,32,48,32"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextAlignment="Center"
            TextWrapping="WrapWholeWords"
            Visibility="Collapsed" />
    </Grid>
</Page>
