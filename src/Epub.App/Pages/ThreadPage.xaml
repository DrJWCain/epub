<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Epub_App.Pages.ThreadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Epub_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="24,16,24,8" Spacing="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource TitleTextBlockStyle}" Text="Threads" />
                <DropDownButton x:Name="SavedButton" Grid.Column="1" Content="Saved" VerticalAlignment="Center">
                    <DropDownButton.Flyout>
                        <Flyout x:Name="SavedFlyout" Opening="SavedFlyout_Opening">
                            <Grid Width="380" MaxHeight="480">
                                <ListView
                                    x:Name="SavedList"
                                    IsItemClickEnabled="True"
                                    ItemClick="SavedList_ItemClick"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:SavedThreadItem">
                                            <Grid Padding="0,4,0,4" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind Query}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="WrapWholeWords"
                                                        MaxLines="2" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind CreatedDisplay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Content="✕"
                                                    Padding="4,2,4,2"
                                                    FontSize="11"
                                                    Click="DeleteSaved_Click"
                                                    Tag="{x:Bind Id}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="SavedEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No saved threads yet — generate one and it'll be saved automatically."
                                    TextWrapping="WrapWholeWords"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Generate a thematic reading sequence stitched from passages across your library, with one-line transitions between them."
                TextWrapping="WrapWholeWords" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="QueryBox"
                    Grid.Column="0"
                    PlaceholderText="What concept do you want to explore?"
                    KeyDown="QueryBox_KeyDown" />
                <ComboBox
                    x:Name="LengthBox"
                    Grid.Column="1"
                    Width="80"
                    SelectedIndex="1">
                    <x:Int32>5</x:Int32>
                    <x:Int32>10</x:Int32>
                    <x:Int32>20</x:Int32>
                </ComboBox>
                <Button
                    x:Name="GenerateButton"
                    Grid.Column="2"
                    Click="Generate_Click"
                    Content="Generate"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="CancelButton"
                    Grid.Column="3"
                    Click="Cancel_Click"
                    Content="Cancel"
                    Visibility="Collapsed" />
            </Grid>

            <ProgressBar
                x:Name="ProgressBar"
                Visibility="Collapsed"
                IsIndeterminate="True" />
            <TextBlock
                x:Name="StatusLabel"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text=""
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel
                    x:Name="ThreadPanel"
                    Padding="24,8,24,24"
                    MaxWidth="800"
                    HorizontalAlignment="Stretch"
                    Spacing="16" />
                <TextBlock
                    x:Name="EmptyState"
                    MaxWidth="500"
                    Margin="48,32,48,32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
