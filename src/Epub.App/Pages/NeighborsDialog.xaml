<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Epub_App.Pages.NeighborsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Epub_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Related passages"
    CloseButtonText="Close"
    DefaultButton="Close"
    mc:Ignorable="d">

    <Grid Width="640" Height="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing
                x:Name="ProgressRing"
                Grid.Column="0"
                Width="20"
                Height="20"
                IsActive="True" />
            <TextBlock
                x:Name="StatusLabel"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Searching the library…" />
        </Grid>

        <ListView
            x:Name="ResultsList"
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="Result_Click"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:NeighborItem">
                    <StackPanel Padding="0,8,0,8" Spacing="4">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind Snippet}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Subtitle}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
